{
  "name": "noxymusic",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Play, DJ, loop and record music with your hands in the browser",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "python3 -m http.server 8000",
    "build": "node scripts/build-sw.mjs",
    "lint": "eslint js",
    "check": "node scripts/check.mjs",
    "test": "node --test",
    "verify": "npm run lint && npm run check && npm test"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2"
  }
}
